# Application under test
BASE_URL=https://staging.company.com
WRITE_URL=https://staging-write.company.com
MOCK_NETWORK=false

# Test accounts (never commit real credentials)
TEST_ACCOUNT_1_EMAIL=account1@example.com
TEST_ACCOUNT_1_PASSWORD=change-me
TEST_ACCOUNT_2_EMAIL=account2@example.com
TEST_ACCOUNT_2_PASSWORD=change-me
TEST_ACCOUNT_3_EMAIL=account3@example.com
TEST_ACCOUNT_3_PASSWORD=change-me

# Optional: force a specific login account (0-based index into TEST_ACCOUNT_1..3).
# When unset, accounts rotate per worker. Set this to swap accounts without code edits.
# TEST_ACCOUNT_INDEX=0

# Accounts used by builders (e.g. UserBuilder) — must exist in any environment file
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=adminPassword123
CUSTOMER_EMAIL=customer@company.com
CUSTOMER_PASSWORD=customerPassword123

# Register account used by the registration smoke test (never commit real credentials)
TEST_REGISTER_EMAIL=test-register@example.com
TEST_REGISTER_PASSWORD=change-me

# Dev API host for ReturnAllApi (differs from BASE_URL). JWT below must be rotated when expired.
DEV_API_URL=https://api.company.com
BGT_SECRET=change-me
API_AUTH_TOKEN=change-me
